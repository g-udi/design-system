    "fonts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sans",
        "serif",
        "mono",
        "heading"
      ],
      "properties": {
        "sans": {
          "$ref": "#/$defs/cssValue",
          "description": "font-family list for --ds-font-sans"
        },
        "serif": {
          "$ref": "#/$defs/cssValue",
          "description": "font-family list for --ds-font-serif"
        },
        "mono": {
          "$ref": "#/$defs/cssValue",
