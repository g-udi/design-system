    "radius": {
      "type": "string",
      "pattern": "^(?:0|\\d*\\.?\\d+(?:px|rem|em))$",
      "description": "Base corner radius (--ds-radius)."
    },
    "spacing": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 2,
      "description": "Density multiplier (--ds-space-scale)."
    },
    "tracking": {
      "type": "string",
      "pattern": "^-?(?:0|\\d*\\.?\\d+(?:em|rem|px))$",
      "description": "Body letter-spacing."
    }
  },
  "$defs": {
    "cssValue": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^;{}<>\\\\]+$"
    },
    "color": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:#[0-9a-fA-F]{3,8}|(?:rgb|rgba|hsl|hsla|oklch|oklab)\\([^;{}<>\\\\]+\\)|black|white|transparent)$"
    }
  }
