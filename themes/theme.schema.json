      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$",
      "description": "Slug used in data-theme=\"<id>\"."
    },
    "name": {
      "$ref": "#/$defs/cssValue"
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cssValue"
      }
