  "title": "Icons, loading and links",
  "description": "Icons, loading and links. Core/Button pattern composed from @gaudi/design-system/core/Button and other public Gaudi components; the components stay package imports.",
  "dependencies": [
    "@gaudi/design-system"
  ],
  "categories": [
    "button",
