{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "menubar-application",
  "type": "registry:example",
  "title": "Application menubar",
  "description": "Application menubar. Core/Overlays & Menus/DropdownMenu pattern composed from @gaudi/design-system/core/DropdownMenu and other public Gaudi components; the components stay package imports.",
  "dependencies": [
    "@gaudi/design-system"
  ],
  "categories": [
    "menubar",
    "core"
  ],
  "docs": "Copy-in pattern built on @gaudi/design-system; the components stay package imports. Load '@gaudi/design-system/global.css' once and add transpilePackages: ['@gaudi/design-system'] in Next.js. Until the package is on npm, install it from GitHub first: pnpm add github:g-udi/design-system.",
  "meta": {
    "owner": "core/DropdownMenu",
    "import": "@gaudi/design-system/core/DropdownMenu",
    "storyId": "core-dropdownmenu--menubar-application",
    "source": "src/components/core/DropdownMenu/stories/fixtures/menubar/menubar-application.jsx"
  },
  "files": [
    {
      "path": "registry/gaudi/examples/menubar-application.jsx",
      "type": "registry:component",
      "content": "'use client';\nimport { useState } from 'react';\nimport {\n  Menubar,\n  MenubarCheckboxItem,\n  MenubarContent,\n  MenubarGroup,\n  MenubarItem,\n  MenubarLabel,\n  MenubarMenu,\n  MenubarRadioGroup,\n  MenubarRadioItem,\n  MenubarSeparator,\n  MenubarShortcut,\n  MenubarSub,\n  MenubarSubContent,\n  MenubarSubTrigger,\n  MenubarTrigger\n} from '@gaudi/design-system/core/DropdownMenu';\nimport { RegistryIcon } from '@gaudi/design-system/icons/RegistryIcon';\nconst formats = [\n  { id: 'strikethrough', label: 'Strikethrough' },\n  { id: 'code', label: 'Code' },\n  { id: 'highlight', label: 'Highlight (unavailable)', disabled: true }\n];\n// An editor menubar: icons, shortcuts, disabled items, submenus, checkboxes, a radio group and a destructive action.\nexport function Pattern() {\n  const [marks, setMarks] = useState({ strikethrough: true, code: false });\n  const [view, setView] = useState({ bookmarks: false, urls: true });\n  const [theme, setTheme] = useState('system');\n  return (\n    <div className='flex items-center justify-center'>\n      <Menubar>\n        <MenubarMenu>\n          <MenubarTrigger>File</MenubarTrigger>\n          <MenubarContent>\n            <MenubarItem>\n              <RegistryIcon lucide='FileIcon' />\n              New file <MenubarShortcut>⌘N</MenubarShortcut>\n            </MenubarItem>\n            <MenubarItem>\n              <RegistryIcon lucide='FolderIcon' />\n              Open folder\n            </MenubarItem>\n            <MenubarItem disabled>New incognito window</MenubarItem>\n            <MenubarSeparator />\n            <MenubarSub>\n              <MenubarSubTrigger>\n                <RegistryIcon lucide='Share2Icon' />\n                Share\n              </MenubarSubTrigger>\n              <MenubarSubContent>\n                <MenubarItem>Email link</MenubarItem>\n                <MenubarItem>Messages</MenubarItem>\n                <MenubarItem>Notes</MenubarItem>\n              </MenubarSubContent>\n            </MenubarSub>\n            <MenubarItem>\n              <RegistryIcon lucide='SaveIcon' />\n              Save <MenubarShortcut>⌘S</MenubarShortcut>\n            </MenubarItem>\n            <MenubarItem>\n              <RegistryIcon lucide='PrinterIcon' />\n              Print… <MenubarShortcut>⌘P</MenubarShortcut>\n            </MenubarItem>\n          </MenubarContent>\n        </MenubarMenu>\n        <MenubarMenu>\n          <MenubarTrigger>Edit</MenubarTrigger>\n          <MenubarContent>\n            <MenubarItem>\n              Undo <MenubarShortcut>⌘Z</MenubarShortcut>\n            </MenubarItem>\n            <MenubarItem>\n              Redo <MenubarShortcut>⇧⌘Z</MenubarShortcut>\n            </MenubarItem>\n            <MenubarSeparator />\n            <MenubarSub>\n              <MenubarSubTrigger>\n                <RegistryIcon lucide='SearchIcon' />\n                Find\n              </MenubarSubTrigger>\n              <MenubarSubContent>\n                <MenubarItem>Find…</MenubarItem>\n                <MenubarItem>Find next</MenubarItem>\n                <MenubarItem>Find previous</MenubarItem>\n              </MenubarSubContent>\n            </MenubarSub>\n            <MenubarSeparator />\n            <MenubarItem>Cut</MenubarItem>\n            <MenubarItem>Copy</MenubarItem>\n            <MenubarItem>Paste</MenubarItem>\n          </MenubarContent>\n        </MenubarMenu>\n        <MenubarMenu>\n          <MenubarTrigger>Format</MenubarTrigger>\n          <MenubarContent>\n            <MenubarItem>\n              <RegistryIcon lucide='BoldIcon' />\n              Bold <MenubarShortcut>⌘B</MenubarShortcut>\n            </MenubarItem>\n            <MenubarItem>\n              <RegistryIcon lucide='ItalicIcon' />\n              Italic <MenubarShortcut>⌘I</MenubarShortcut>\n            </MenubarItem>\n            <MenubarSeparator />\n            {formats.map((item) => (\n              <MenubarCheckboxItem\n                key={item.id}\n                disabled={item.disabled}\n                checked={marks[item.id]}\n                onCheckedChange={(checked) => setMarks((prev) => ({ ...prev, [item.id]: checked }))}\n              >\n                {item.label}\n              </MenubarCheckboxItem>\n            ))}\n            <MenubarSeparator />\n            <MenubarSub>\n              <MenubarSubTrigger>\n                <RegistryIcon lucide='ImageIcon' />\n                Insert media\n              </MenubarSubTrigger>\n              <MenubarSubContent>\n                <MenubarItem>Image</MenubarItem>\n                <MenubarItem>Video</MenubarItem>\n              </MenubarSubContent>\n            </MenubarSub>\n            <MenubarItem>\n              <RegistryIcon lucide='LinkIcon' />\n              Link <MenubarShortcut>⌘K</MenubarShortcut>\n            </MenubarItem>\n          </MenubarContent>\n        </MenubarMenu>\n        <MenubarMenu>\n          <MenubarTrigger>View</MenubarTrigger>\n          <MenubarContent className='w-56'>\n            <MenubarCheckboxItem\n              checked={view.bookmarks}\n              onCheckedChange={(checked) => setView((prev) => ({ ...prev, bookmarks: checked }))}\n            >\n              Show bookmarks bar\n            </MenubarCheckboxItem>\n            <MenubarCheckboxItem\n              checked={view.urls}\n              onCheckedChange={(checked) => setView((prev) => ({ ...prev, urls: checked }))}\n            >\n              Show full URLs\n            </MenubarCheckboxItem>\n            <MenubarSeparator />\n            <MenubarGroup>\n              <MenubarLabel>Theme</MenubarLabel>\n              <MenubarRadioGroup value={theme} onValueChange={setTheme}>\n                <MenubarRadioItem value='light'>Light</MenubarRadioItem>\n                <MenubarRadioItem value='dark'>Dark</MenubarRadioItem>\n                <MenubarRadioItem value='system'>System</MenubarRadioItem>\n              </MenubarRadioGroup>\n            </MenubarGroup>\n          </MenubarContent>\n        </MenubarMenu>\n        <MenubarMenu>\n          <MenubarTrigger>Account</MenubarTrigger>\n          <MenubarContent>\n            <MenubarItem>\n              <RegistryIcon lucide='UserIcon' />\n              Profile\n            </MenubarItem>\n            <MenubarSeparator />\n            <MenubarItem variant='destructive'>\n              <RegistryIcon lucide='LogOutIcon' />\n              Sign out\n            </MenubarItem>\n          </MenubarContent>\n        </MenubarMenu>\n      </Menubar>\n    </div>\n  );\n}\n"
    }
  ]
}
