{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "forms-new-product",
  "type": "registry:block",
  "title": "Commerce · New product",
  "description": "Commerce · New product. Blocks/Forms pattern composed from @gaudi/design-system/blocks/Forms and other public Gaudi components; the components stay package imports.",
  "dependencies": [
    "@gaudi/design-system"
  ],
  "categories": [
    "forms",
    "blocks"
  ],
  "docs": "Copy-in block built on @gaudi/design-system; the components stay package imports. Load '@gaudi/design-system/global.css' once and add transpilePackages: ['@gaudi/design-system'] in Next.js. Until the package is on npm, install it from GitHub first: pnpm add github:ahmadassaf/design-system.",
  "meta": {
    "owner": "blocks/Forms",
    "import": "@gaudi/design-system/blocks/Forms",
    "storyId": "blocks-forms--new-product",
