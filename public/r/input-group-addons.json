  "files": [
    {
      "path": "registry/gaudi/examples/input-group-addons.jsx",
      "type": "registry:component",
      "content": "'use client';\nimport { useState } from 'react';\nimport {\n  FieldRoot as Field,\n  FieldLabelPrimitive as FieldLabel\n} from '@gaudi/design-system/core/Field';\nimport {\n  InputGroup,\n  InputGroupAddon,\n  InputGroupInput,\n  InputGroupText,\n  InputGroupTextarea\n} from '@gaudi/design-system/core/Input';\nimport { RegistryIcon } from '@gaudi/design-system/icons/RegistryIcon';\nimport { EmailInput } from '@gaudi/design-system/core/Input';\nimport { NumberField, NumberFieldGroup, NumberFieldInput } from '@gaudi/design-system/core/NumberField';\n\nconst maxLength = 140;\n\nfunction Cell({ id, label, className, children }) {\n  return (\n    <Field className={className}>\n      <FieldLabel htmlFor={id} className='text-xs font-normal text-text-muted'>{label}</FieldLabel>\n      {children}\n    </Field>\n  );\n}\n\nexport function Pattern() {\n  const [description, setDescription] = useState('');\n  return (\n    <div className='mx-auto grid w-full max-w-xl gap-x-5 gap-y-6 sm:grid-cols-2'>\n      <Cell id='ig-plain' label='Plain'>\n        <InputGroup>\n          <InputGroupInput id='ig-plain' placeholder='Search…' />\n        </InputGroup>\n      </Cell>\n      <Cell id='ig-leading-icon' label='Leading icon'>\n        <InputGroup>\n          <InputGroupAddon>\n            <RegistryIcon lucide='SearchIcon' />\n          </InputGroupAddon>\n          <InputGroupInput id='ig-leading-icon' placeholder='Search…' />\n        </InputGroup>\n      </Cell>\n      <Cell id='ig-trailing-icon' label='Trailing icon'>\n        <EmailInput id='ig-trailing-icon' placeholder='you@example.com' suffix={<RegistryIcon lucide='MailIcon' />} />\n      </Cell>\n      <Cell id='ig-both-icons' label='Icons on both sides'>\n        <InputGroup>\n          <InputGroupAddon>\n            <RegistryIcon lucide='MicIcon' />\n          </InputGroupAddon>\n          <InputGroupInput id='ig-both-icons' placeholder='Listening…' />\n          <InputGroupAddon align='inline-end'>\n            <RegistryIcon lucide='RadioIcon' className='animate-pulse text-danger' />\n          </InputGroupAddon>\n        </InputGroup>\n      </Cell>\n      <Cell id='ig-leading-text' label='Leading text'>\n        <InputGroup>\n          <InputGroupAddon>\n            <InputGroupText>https://</InputGroupText>\n          </InputGroupAddon>\n          <InputGroupInput id='ig-leading-text' placeholder='example.com' />\n        </InputGroup>\n      </Cell>\n      <Cell id='ig-trailing-text' label='Trailing text'>\n        <InputGroup>\n          <InputGroupInput id='ig-trailing-text' placeholder='username' />\n          <InputGroupAddon align='inline-end'>\n            <InputGroupText>@gaudi.dev</InputGroupText>\n          </InputGroupAddon>\n        </InputGroup>\n      </Cell>\n      <Cell id='ig-both-text' label='Text on both sides'>\n        <NumberField id='ig-both-text'>\n          <NumberFieldGroup>\n            <InputGroupAddon>\n              <InputGroupText>$</InputGroupText>\n            </InputGroupAddon>\n            <NumberFieldInput placeholder='0.00' />\n            <InputGroupAddon align='inline-end'>\n              <InputGroupText>USD</InputGroupText>\n            </InputGroupAddon>\n          </NumberFieldGroup>\n        </NumberField>\n      </Cell>\n      <Cell id='ig-divided' label='Divided addons'>\n        <InputGroup>\n          <InputGroupAddon className='pr-2'>\n            <InputGroupText>€</InputGroupText>\n          </InputGroupAddon>\n          <InputGroupInput id='ig-divided' placeholder='0.00' className='border-x border-border' />\n          <InputGroupAddon align='inline-end' className='pl-2'>\n            <InputGroupText>EUR</InputGroupText>\n          </InputGroupAddon>\n        </InputGroup>\n      </Cell>\n      <Cell id='ig-block-start' label='Block-start header' className='sm:col-span-2'>\n        <InputGroup className='h-auto'>\n          <InputGroupInput id='ig-block-start' placeholder='First name' />\n          <InputGroupAddon align='block-start'>\n            <InputGroupText className='font-medium'>User profile</InputGroupText>\n            <RegistryIcon lucide='InfoIcon' className='ml-auto' />\n          </InputGroupAddon>\n        </InputGroup>\n      </Cell>\n      <Cell id='ig-block-end' label='Block-end footer' className='sm:col-span-2'>\n        <InputGroup>\n          <InputGroupTextarea\n            id='ig-block-end'\n            placeholder='Description…'\n            value={description}\n            onChange={(e) => setDescription(e.target.value)}\n            maxLength={maxLength}\n            className='min-h-12'\n          />\n          <InputGroupAddon align='block-end'>\n            <InputGroupText className='text-xs tabular-nums text-text-muted'>\n              {description.length}/{maxLength} characters\n            </InputGroupText>\n            <RegistryIcon lucide='InfoIcon' className='ml-auto text-text-muted' />\n          </InputGroupAddon>\n        </InputGroup>\n      </Cell>\n    </div>\n  );\n}\n"
    }
  ]
}
