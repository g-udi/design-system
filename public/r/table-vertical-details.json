      "path": "registry/gaudi/examples/table-vertical-details.jsx",
      "type": "registry:component",
      "content": "import Pill from '@gaudi/design-system/core/Pill';\nimport { ProgressRoot } from '@gaudi/design-system/core/Progress';\nimport { Badge } from '@gaudi/design-system/core/Pill';\nimport {\n  Frame,\n  FrameDescription,\n  FrameHeader,\n  FramePanel,\n  FrameTitle\n} from '@gaudi/design-system/core/Card';\nimport {\n  TableRoot as Table,\n  TableBodyPrimitive as TableBody,\n  TableCellPrimitive as TableCell,\n  TableRowPrimitive as TableRow\n} from '@gaudi/design-system/mdx/Table';\nexport function Pattern() {\n  return (\n    <div className='mx-auto flex w-full max-w-lg flex-col'>\n      <Frame spacing='sm'>\n        <FrameHeader className='px-2!'>\n          <FrameTitle>Server status</FrameTitle>\n          <FrameDescription>\n            Primary production server{' '}\n            <Badge variant='outline' size='sm'>\n              prod-api-us-east-1\n            </Badge>\n          </FrameDescription>\n        </FrameHeader>\n        <FramePanel className='p-0!'>\n          <Table>\n            <TableBody>\n              <TableRow className='*:border-border hover:bg-transparent [&>:not(:last-child)]:border-r'>\n                <TableCell as='th' scope='row' className='bg-surface-muted w-40 py-2 text-sm font-medium'>\n                  Status\n                </TableCell>\n                <TableCell className='py-2'>\n                  <Pill tone='green' variant='subtle' pulse>Operational</Pill>\n                </TableCell>\n              </TableRow>\n              <TableRow className='*:border-border hover:bg-transparent [&>:not(:last-child)]:border-r'>\n                <TableCell as='th' scope='row' className='bg-surface-muted py-2 text-sm font-medium'>\n                  Instance Type\n                </TableCell>\n                <TableCell className='py-2'>\n                  <span className='font-mono text-sm'>c6g.2xlarge</span>\n                </TableCell>\n              </TableRow>\n              <TableRow className='*:border-border hover:bg-transparent [&>:not(:last-child)]:border-r'>\n                <TableCell as='th' scope='row' className='bg-surface-muted py-2 text-sm font-medium'>\n                  Region\n                </TableCell>\n                <TableCell className='py-2 text-sm'>\n                  US East (N. Virginia)\n                </TableCell>\n              </TableRow>\n              <TableRow className='*:border-border hover:bg-transparent [&>:not(:last-child)]:border-r'>\n                <TableCell as='th' scope='row' className='bg-surface-muted py-2 text-sm font-medium'>\n                  CPU Usage\n                </TableCell>\n                <TableCell className='py-2'>\n                  <div className='flex items-center gap-3'>\n                    <ProgressRoot value={42} aria-label='CPU usage' className='h-2 w-24' />\n                    <span className='text-text-muted text-sm'>\n                      42%\n                    </span>\n                  </div>\n                </TableCell>\n              </TableRow>\n              <TableRow className='*:border-border hover:bg-transparent [&>:not(:last-child)]:border-r'>\n                <TableCell as='th' scope='row' className='bg-surface-muted py-2 text-sm font-medium'>\n                  Memory\n                </TableCell>\n                <TableCell className='py-2'>\n                  <div className='flex items-center gap-3'>\n                    <ProgressRoot value={67} aria-label='Memory usage' className='h-2 w-24 *:data-[slot=progress-indicator]:bg-warning' />\n                    <span className='text-text-muted text-sm'>\n                      10.7 / 16 GB\n                    </span>\n                  </div>\n                </TableCell>\n              </TableRow>\n              <TableRow className='*:border-border hover:bg-transparent [&>:not(:last-child)]:border-r'>\n                <TableCell as='th' scope='row' className='bg-surface-muted py-2 text-sm font-medium'>\n                  Uptime\n                </TableCell>\n                <TableCell className='py-2 text-sm'>\n                  47 days, 12 hours\n                </TableCell>\n              </TableRow>\n              <TableRow className='*:border-border hover:bg-transparent [&>:not(:last-child)]:border-r'>\n                <TableCell as='th' scope='row' className='bg-surface-muted py-2 text-sm font-medium'>\n                  OS\n                </TableCell>\n                <TableCell className='py-2 text-sm'>\n                  Amazon Linux 2023\n                </TableCell>\n              </TableRow>\n              <TableRow className='*:border-border hover:bg-transparent [&>:not(:last-child)]:border-r'>\n                <TableCell as='th' scope='row' className='bg-surface-muted py-2 text-sm font-medium'>\n                  Tags\n                </TableCell>\n                <TableCell className='py-2'>\n                  <div className='flex flex-wrap gap-1.5'>\n                    <Badge variant='secondary' size='sm'>\n                      production\n                    </Badge>\n                    <Badge variant='secondary' size='sm'>\n                      api\n                    </Badge>\n                    <Badge variant='secondary' size='sm'>\n                      critical\n                    </Badge>\n                  </div>\n                </TableCell>\n              </TableRow>\n            </TableBody>\n          </Table>\n        </FramePanel>\n      </Frame>\n    </div>\n  );\n}\n"
    }
  ]
}
