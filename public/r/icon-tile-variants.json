  "title": "Variants, sizes and shapes",
  "description": "Variants, sizes and shapes. Core/Icon pattern composed from @gaudi/design-system/core/Icon and other public Gaudi components; the components stay package imports.",
  "dependencies": [
    "@gaudi/design-system"
  ],
