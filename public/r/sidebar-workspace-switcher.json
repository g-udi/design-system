{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "sidebar-workspace-switcher",
  "type": "registry:block",
  "title": "Workspace switcher",
  "description": "Workspace switcher. Blocks/App Shell pattern composed from @gaudi/design-system/blocks/AppShell and other public Gaudi components; the components stay package imports.",
  "dependencies": [
    "@gaudi/design-system"
  ],
  "categories": [
    "sidebar",
    "blocks"
  ],
  "docs": "Copy-in block built on @gaudi/design-system; the components stay package imports. Load '@gaudi/design-system/global.css' once and add transpilePackages: ['@gaudi/design-system'] in Next.js. Until the package is on npm, install it from GitHub first: pnpm add github:ahmadassaf/design-system. Demo assets referenced (supply your own or copy them into public/): /avatars/person-20.svg, /avatars/person-31.svg, /avatars/person-41.svg.",
  "meta": {
    "owner": "blocks/AppShell",
    "import": "@gaudi/design-system/blocks/AppShell",
    "storyId": "blocks-application-appshell--sidebar-workspace-switcher",
    "source": "src/components/blocks/AppShell/stories/fixtures/sidebar/sidebar-workspace-switcher.jsx",
    "assets": [
      "/avatars/person-20.svg",
      "/avatars/person-31.svg",
      "/avatars/person-41.svg"
    ]
  },
  "files": [
    {
      "path": "registry/gaudi/blocks/sidebar-workspace-switcher.jsx",
      "type": "registry:component",
      "content": "'use client';\nimport { useState } from 'react';\nimport { cn } from '@gaudi/design-system/utilities/cn';\nimport {\n  AvatarRoot as Avatar,\n  AvatarFallback,\n  AvatarImage\n} from '@gaudi/design-system/core/Avatar';\nimport {\n  BreadcrumbRoot as Breadcrumb,\n  BreadcrumbItemPrimitive as BreadcrumbItem,\n  BreadcrumbLinkPrimitive as BreadcrumbLink,\n  BreadcrumbListPrimitive as BreadcrumbList,\n  BreadcrumbPagePrimitive as BreadcrumbPage,\n  BreadcrumbSeparatorPrimitive as BreadcrumbSeparator\n} from '@gaudi/design-system/core/Breadcrumb';\nimport { default as Button } from '@gaudi/design-system/core/Button';\nimport {\n  CardRoot as Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle\n} from '@gaudi/design-system/core/Card';\nimport {\n  DropdownMenuRoot as DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuGroup,\n  DropdownMenuItemPrimitive as DropdownMenuItem,\n  DropdownMenuLabelPrimitive as DropdownMenuLabel,\n  DropdownMenuSeparatorPrimitive as DropdownMenuSeparator,\n  DropdownMenuShortcut,\n  DropdownMenuTrigger\n} from '@gaudi/design-system/core/DropdownMenu';\nimport {\n  Sidebar,\n  SidebarContent,\n  SidebarFooter,\n  SidebarGroup,\n  SidebarGroupAction,\n  SidebarGroupContent,\n  SidebarGroupLabel,\n  SidebarHeader,\n  SidebarInset,\n  SidebarMenu,\n  SidebarMenuAction,\n  SidebarMenuBadge,\n  SidebarMenuButton,\n  SidebarMenuItem,\n  SidebarProvider,\n  SidebarSeparator,\n  SidebarTrigger\n} from '@gaudi/design-system/blocks/AppShell';\nimport { AppShellFrame } from '@gaudi/design-system/blocks/AppShell';\nimport { RegistryIcon } from '@gaudi/design-system/icons/RegistryIcon';\nconst WORKSPACES = [\n  {\n    id: 'gaudi-workspace',\n    name: 'Gaudi Workspace',\n    plan: 'Pro',\n    initials: 'RL',\n    avatar:\n      '/avatars/person-41.svg'\n  },\n  {\n    id: 'acme',\n    name: 'Gaudi',\n    plan: 'Team',\n    initials: 'GA',\n    avatar:\n      '/avatars/person-20.svg'\n  },\n  {\n    id: 'personal',\n    name: 'Personal',\n    plan: 'Free',\n    initials: 'PS',\n    avatar:\n      '/avatars/person-31.svg'\n  }\n];\nconst NAV = [\n  {\n    id: 'overview',\n    label: 'Overview',\n    icon: <RegistryIcon lucide='LayoutDashboardIcon' aria-hidden='true' />\n  },\n  {\n    id: 'inbox',\n    label: 'Inbox',\n    badge: 12,\n    icon: <RegistryIcon lucide='InboxIcon' aria-hidden='true' />\n  },\n  {\n    id: 'deployments',\n    label: 'Deployments',\n    isActive: true,\n    icon: <RegistryIcon lucide='RocketIcon' aria-hidden='true' />\n  },\n  {\n    id: 'analytics',\n    label: 'Analytics',\n    icon: <RegistryIcon lucide='BarChart3Icon' aria-hidden='true' />\n  },\n  {\n    id: 'logs',\n    label: 'Logs',\n    badge: 3,\n    icon: <RegistryIcon lucide='FileTextIcon' aria-hidden='true' />\n  },\n  {\n    id: 'storage',\n    label: 'Storage',\n    icon: <RegistryIcon lucide='LayersIcon' aria-hidden='true' />\n  }\n];\nconst PROJECTS = [\n  { id: 'checkout', name: 'Checkout API' },\n  { id: 'design-system', name: 'Design system' },\n  { id: 'marketing', name: 'Marketing site' },\n  { id: 'edge-cache', name: 'Edge cache' }\n];\nconst DEPLOYMENTS = [\n  {\n    id: 'd-4821',\n    title: 'Shorten the image cache lifetime',\n    branch: 'main',\n    time: '12m ago'\n  },\n  {\n    id: 'd-4820',\n    title: 'Split the archive page by year',\n    branch: 'release/2.8',\n    time: '1h ago'\n  },\n  {\n    id: 'd-4819',\n    title: 'Serve feeds from the edge cache',\n    branch: 'feat/edge',\n    time: '3h ago',\n    failed: true\n  },\n  {\n    id: 'd-4818',\n    title: 'Add language fallbacks to search',\n    branch: 'main',\n    time: 'Yesterday'\n  }\n];\nconst STATS = [\n  { id: 'build', label: 'Build time', value: '42s' },\n  { id: 'success', label: 'Success rate', value: '99.2%' },\n  { id: 'prs', label: 'Open PRs', value: '7' }\n];\nfunction BrandMark({ className }) {\n  return (\n    <span\n      aria-hidden='true'\n      className={cn(\n        'bg-ui-sidebar-primary text-ui-sidebar-primary-foreground flex size-6 shrink-0 items-center justify-center rounded-md',\n        className\n      )}\n    >\n      <svg\n        viewBox='25.5002 25.1352 50 50'\n        fill='none'\n        xmlns='http://www.w3.org/2000/svg'\n        className='size-3'\n      >\n        <circle cx='70.634' cy='29.8334' r='4.69799' fill='currentColor' />\n        <path\n          fillRule='evenodd'\n          clipRule='evenodd'\n          d='M25.668 57.0144V29.8332C25.668 27.2386 27.7713 25.1352 30.366 25.1352C32.9606 25.1352 35.0639 27.2386 35.0639 29.8332V57.0144C35.0639 61.833 38.9702 65.7392 43.7888 65.7392H57.2116C62.0302 65.7392 65.9364 61.833 65.9364 57.0144V43.7258C65.9364 41.1312 68.0398 39.0278 70.6344 39.0278C73.229 39.0278 75.3324 41.1312 75.3324 43.7258V57.0144C75.3324 67.0222 67.2194 75.1352 57.2116 75.1352H43.7888C33.7809 75.1352 25.668 67.0222 25.668 57.0144Z'\n          fill='currentColor'\n        />\n      </svg>\n    </span>\n  );\n}\nfunction WorkspaceSwitcher({ workspace, onSelect }) {\n  return (\n    <SidebarMenu>\n      <SidebarMenuItem>\n        <DropdownMenu>\n          <DropdownMenuTrigger asChild>\n            <SidebarMenuButton\n              size='lg'\n              className='aria-expanded:bg-ui-sidebar-accent aria-expanded:text-ui-sidebar-accent-foreground'\n            >\n              <BrandMark className='size-8 rounded-lg [&>svg]:size-4' />\n              <span className='grid min-w-0 flex-1 text-left leading-tight'>\n                <span className='truncate text-sm font-medium'>\n                  {workspace.name}\n                </span>\n                <span className='text-ui-sidebar-foreground truncate text-xs'>\n                  {workspace.plan} plan\n                </span>\n              </span>\n              <RegistryIcon\n                lucide='ChevronsUpDownIcon'\n                className='ml-auto opacity-60'\n                aria-hidden='true'\n              />\n            </SidebarMenuButton>\n          </DropdownMenuTrigger>\n          <DropdownMenuContent side='bottom' align='start'>\n            <DropdownMenuGroup>\n              <DropdownMenuLabel>Workspaces</DropdownMenuLabel>\n              {WORKSPACES.map((item) => (\n                <DropdownMenuItem key={item.id} onClick={() => onSelect(item)}>\n                  <Avatar size='sm'>\n                    <AvatarImage src={item.avatar} alt='' />\n                    <AvatarFallback>{item.initials}</AvatarFallback>\n                  </Avatar>\n                  <span className='truncate'>{item.name}</span>\n                  {item.id === workspace.id ? (\n                    <RegistryIcon\n                      lucide='CheckIcon'\n                      className='ml-auto size-3.5'\n                      aria-hidden='true'\n                    />\n                  ) : null}\n                </DropdownMenuItem>\n              ))}\n            </DropdownMenuGroup>\n            <DropdownMenuSeparator />\n            <DropdownMenuGroup>\n              <DropdownMenuItem>\n                <RegistryIcon lucide='PlusIcon' aria-hidden='true' />\n                New workspace\n              </DropdownMenuItem>\n            </DropdownMenuGroup>\n          </DropdownMenuContent>\n        </DropdownMenu>\n      </SidebarMenuItem>\n    </SidebarMenu>\n  );\n}\nfunction WorkspaceNav() {\n  return (\n    <SidebarGroup>\n      <SidebarGroupLabel>Workspace</SidebarGroupLabel>\n      <SidebarGroupContent>\n        <SidebarMenu>\n          {NAV.map((item) => (\n            <SidebarMenuItem key={item.id}>\n              <SidebarMenuButton asChild isActive={item.isActive}>\n                <a href='#'>\n                  {item.icon}\n                  <span>{item.label}</span>\n                </a>\n              </SidebarMenuButton>\n              {item.badge ? (\n                <SidebarMenuBadge>{item.badge}</SidebarMenuBadge>\n              ) : null}\n            </SidebarMenuItem>\n          ))}\n        </SidebarMenu>\n      </SidebarGroupContent>\n    </SidebarGroup>\n  );\n}\nfunction ProjectNav() {\n  return (\n    <SidebarGroup>\n      <SidebarGroupLabel>Projects</SidebarGroupLabel>\n      <SidebarGroupAction type='button'>\n        <RegistryIcon lucide='PlusIcon' aria-hidden='true' />\n        <span className='sr-only'>New project</span>\n      </SidebarGroupAction>\n      <SidebarGroupContent>\n        <SidebarMenu>\n          {PROJECTS.map((project) => (\n            <SidebarMenuItem key={project.id}>\n              <SidebarMenuButton asChild>\n                <a href='#'>\n                  <RegistryIcon lucide='FolderIcon' aria-hidden='true' />\n                  <span>{project.name}</span>\n                </a>\n              </SidebarMenuButton>\n              <DropdownMenu>\n                <DropdownMenuTrigger asChild>\n                  <SidebarMenuAction\n                    showOnHover\n                    aria-label={`Actions for ${project.name}`}\n                  >\n                    <RegistryIcon\n                      lucide='MoreHorizontalIcon'\n                      aria-hidden='true'\n                    />\n                  </SidebarMenuAction>\n                </DropdownMenuTrigger>\n                <DropdownMenuContent side='right' align='start'>\n                  <DropdownMenuGroup>\n                    <DropdownMenuItem>Rename</DropdownMenuItem>\n                    <DropdownMenuItem>\n                      <RegistryIcon lucide='CopyIcon' aria-hidden='true' />\n                      Duplicate\n                    </DropdownMenuItem>\n                  </DropdownMenuGroup>\n                  <DropdownMenuSeparator />\n                  <DropdownMenuGroup>\n                    <DropdownMenuItem>\n                      <RegistryIcon lucide='ArchiveIcon' aria-hidden='true' />\n                      Archive\n                    </DropdownMenuItem>\n                  </DropdownMenuGroup>\n                </DropdownMenuContent>\n              </DropdownMenu>\n            </SidebarMenuItem>\n          ))}\n        </SidebarMenu>\n      </SidebarGroupContent>\n    </SidebarGroup>\n  );\n}\nfunction AccountMenu() {\n  return (\n    <SidebarMenu>\n      <SidebarMenuItem>\n        <DropdownMenu>\n          <DropdownMenuTrigger asChild>\n            <SidebarMenuButton\n              size='lg'\n              className='aria-expanded:bg-ui-sidebar-accent aria-expanded:text-ui-sidebar-accent-foreground'\n            >\n              <Avatar>\n                <AvatarImage src='/avatars/person-41.svg' alt='' />\n                <AvatarFallback>NR</AvatarFallback>\n              </Avatar>\n              <span className='grid min-w-0 flex-1 text-left leading-tight'>\n                <span className='truncate text-sm font-medium'>\n                  Nadira Rahimi\n                </span>\n                <span className='text-ui-sidebar-foreground truncate text-xs'>\n                  nadira@example.com\n                </span>\n              </span>\n              <RegistryIcon\n                lucide='MoreHorizontalIcon'\n                className='ml-auto opacity-60'\n                aria-hidden='true'\n              />\n            </SidebarMenuButton>\n          </DropdownMenuTrigger>\n          <DropdownMenuContent side='right' align='end'>\n            <DropdownMenuGroup>\n              <DropdownMenuLabel>Nadira Rahimi</DropdownMenuLabel>\n            </DropdownMenuGroup>\n            <DropdownMenuSeparator />\n            <DropdownMenuGroup>\n              <DropdownMenuItem>\n                <RegistryIcon lucide='UserIcon' aria-hidden='true' />\n                Profile\n              </DropdownMenuItem>\n              <DropdownMenuItem>\n                <RegistryIcon lucide='CreditCardIcon' aria-hidden='true' />\n                Billing\n              </DropdownMenuItem>\n              <DropdownMenuItem>\n                <RegistryIcon lucide='BellIcon' aria-hidden='true' />\n                Notifications\n              </DropdownMenuItem>\n            </DropdownMenuGroup>\n            <DropdownMenuSeparator />\n            <DropdownMenuGroup>\n              <DropdownMenuItem>\n                <RegistryIcon lucide='LogOutIcon' aria-hidden='true' />\n                Sign out\n                <DropdownMenuShortcut>⇧⌘Q</DropdownMenuShortcut>\n              </DropdownMenuItem>\n            </DropdownMenuGroup>\n          </DropdownMenuContent>\n        </DropdownMenu>\n      </SidebarMenuItem>\n    </SidebarMenu>\n  );\n}\nfunction DeploymentRow({ deployment }) {\n  return (\n    <div className='flex items-center gap-2 text-sm'>\n      {deployment.failed ? (\n        <RegistryIcon\n          lucide='AlertCircleIcon'\n          className='text-ui-destructive size-3.5 shrink-0'\n          aria-hidden='true'\n        />\n      ) : (\n        <RegistryIcon\n          lucide='CircleCheckIcon'\n          className='text-success size-3.5 shrink-0'\n          aria-hidden='true'\n        />\n      )}\n      <span className='sr-only'>\n        {deployment.failed ? 'Failed' : 'Succeeded'}\n      </span>\n      <span className='min-w-0 flex-1 truncate'>{deployment.title}</span>\n      <span className='text-ui-muted-foreground hidden shrink-0 text-xs sm:inline'>\n        {deployment.branch}\n      </span>\n      <span className='text-ui-muted-foreground shrink-0 text-xs'>\n        {deployment.time}\n      </span>\n    </div>\n  );\n}\nfunction Workbench({ workspaceName }) {\n  return (\n    <SidebarInset className='min-w-0 overflow-hidden'>\n      <header className='flex h-12 shrink-0 items-center gap-2 border-b px-4'>\n        <SidebarTrigger className='-ml-1' />\n        <Breadcrumb className='min-w-0 flex-1'>\n          <BreadcrumbList className='flex-nowrap'>\n            <BreadcrumbItem className='min-w-0'>\n              <BreadcrumbLink href='#' className='truncate'>\n                {workspaceName}\n              </BreadcrumbLink>\n            </BreadcrumbItem>\n            <BreadcrumbSeparator />\n            <BreadcrumbItem>\n              <BreadcrumbPage>Deployments</BreadcrumbPage>\n            </BreadcrumbItem>\n          </BreadcrumbList>\n        </Breadcrumb>\n        <Button variant='outline' size='sm' className='ml-auto shrink-0 whitespace-nowrap'>\n          Invite\n        </Button>\n      </header>\n\n      <div className='flex-1 overflow-auto p-4'>\n        <div className='grid gap-3 sm:grid-cols-3'>\n          {STATS.map((stat) => (\n            <Card key={stat.id} size='sm'>\n              <CardHeader>\n                <CardDescription>{stat.label}</CardDescription>\n                <CardTitle>{stat.value}</CardTitle>\n              </CardHeader>\n            </Card>\n          ))}\n        </div>\n\n        <Card size='sm' className='mt-3'>\n          <CardHeader>\n            <CardTitle>Recent deployments</CardTitle>\n          </CardHeader>\n          <CardContent>\n            <div className='flex flex-col gap-2.5'>\n              {DEPLOYMENTS.map((deployment) => (\n                <DeploymentRow key={deployment.id} deployment={deployment} />\n              ))}\n            </div>\n          </CardContent>\n        </Card>\n      </div>\n    </SidebarInset>\n  );\n}\nexport function Pattern() {\n  const [workspace, setWorkspace] = useState(WORKSPACES[0]);\n  return (\n    <AppShellFrame>\n      <SidebarProvider className='relative h-full min-h-0 w-full overflow-hidden'>\n        <Sidebar variant='inset' className='absolute h-full'>\n          <SidebarHeader>\n            <WorkspaceSwitcher workspace={workspace} onSelect={setWorkspace} />\n          </SidebarHeader>\n\n          <SidebarContent role='navigation' aria-label='Workspace'>\n            <WorkspaceNav />\n            <ProjectNav />\n          </SidebarContent>\n\n          <SidebarFooter>\n            {/*\n        `mx-0` is a fix, not a preference. SidebarSeparator ships `w-auto`\n        to undo Separator's `data-horizontal:w-full`, but a variant\n        selector outranks a plain utility, so the rule stays full width and\n        the primitive's own `mx-2` then pushes it 8px past the panel's\n        right edge while leaving a 16px gap on the left. Zeroing the margin\n        lines it up with the footer's own padding.\n      */}\n            <SidebarSeparator className='mx-0' />\n            <AccountMenu />\n          </SidebarFooter>\n        </Sidebar>\n\n        <Workbench workspaceName={workspace.name} />\n      </SidebarProvider>\n    </AppShellFrame>\n  );\n}\n"
    }
  ]
}
